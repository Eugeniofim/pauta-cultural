# Copie para .env apenas se for rodar local. NUNCA versione o .env de verdade.
# Em produção estas variáveis ficam no painel do Netlify.

# Chave restrita do Stripe (rk_live_... ou sk_test_... para testar)
# Permissões necessárias: Checkout Sessions gravação, Coupons leitura, Promotion Codes leitura
STRIPE_SECRET_KEY=

# Preço da assinatura Pauta Pro — R$ 9,90/mês
STRIPE_PRICE_ID=price_1U2t3HRtBz2fFckWz9s2QyZp

# Endereço público do site, usado no retorno do checkout
URL_SITE=https://pautacultural.netlify.app
